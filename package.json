{
  "name": "wargames",
  "version": "1.0.0",
  "description": "AI War Games - Multi-agent strategy simulation demo",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "tsx watch server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/index.ts",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "Nobler Works (https://noblerworks.com/)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NoblerWorks-HQ/WarGames.git"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "earcut": "^3.2.4",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/earcut": "^3.2.4",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  }
}
