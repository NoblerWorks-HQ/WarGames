# ===========================================
# War Games - AI Provider Configuration
# ===========================================
# Copy this file to .env and fill in your API key(s).
# You need at least ONE provider key. Add more if you want different factions on different models.

# --- Global Default ---
# All factions use this provider unless overridden below.
AI_PROVIDER=gemini

# --- Per-Faction Overrides (optional) ---
# Uncomment to give each faction a different AI brain.
# NATO_AI_PROVIDER=anthropic
# RUSSIA_AI_PROVIDER=gemini
# CHINA_AI_PROVIDER=openai
# NARRATOR_AI_PROVIDER=anthropic

# --- Google Gemini ---
GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI / ChatGPT ---
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic / Claude ---
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-6
